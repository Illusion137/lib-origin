{
    "lib": ["ESNext"],
    "exclude": ["node_modules"],
    "compilerOptions": {
        "jsx": "react-native",
        "strict": true,
        "noImplicitAny": false,
        "noEmitOnError": true,
        "noEmit": true,
        "esModuleInterop": true,
        "target": "esnext",
        "module": "commonjs",
        "resolveJsonModule": true,
        "sourceMap": true,
        "outDir": "dist",
        "noUnusedLocals": false,
        "noUnusedParameters": true,
        "allowUnreachableCode": false,
        "alwaysStrict": true,
        "noFallthroughCasesInSwitch": true,
        "strictNullChecks": true,
        "noImplicitReturns": true,
        "skipLibCheck": true,
        "allowJs": true,
        "allowSyntheticDefaultImports": true,
        "allowImportingTsExtensions": true,
        "paths": {
            "@native/*": ["./roze/native/*"],
            "@lib/*": ["./roze/lib/*"],
            "@roze/*": ["./roze/src/*", "./roze/*"],
            "@arneb/*": ["./arneb/*"],
            "@origin/*": ["./origin/src/*"],
            "@lutz/*": ["./lutz/src/*"],
            "@sosu/*": ["./sosu/src/*"],
            "@illusive/*": ["./Illusive/src/*"],
            "@illusicord/*": ["./illusicord/src/*"],
            "@common/*": ["./common/*"],
            "@admin/*": ["./admin/*"],
            "@sample/*": ["./sample/*"],
            "react-native-shumil": ["./node_modules/react-native-shumil/src/index.ts"],
            "googlevideo/sabr-stream": ["./node_modules/googlevideo/dist/src/exports/sabr-stream"],
            "googlevideo/utils": ["./node_modules/googlevideo/dist/src/exports/utils"],
            "googlevideo/protos": ["./node_modules/googlevideo/dist/src/exports/protos"],
            "bgutils-js/botguard": ["./node_modules/bgutils-js/dist/exports/botguard"],
            "bgutils-js/webpo": ["./node_modules/bgutils-js/dist/exports/webpo"],
            "bgutils-js/utils": ["./node_modules/bgutils-js/dist/exports/utils"],
            "bgutils-js/shared-types": ["./node_modules/bgutils-js/dist/exports/types"],
        }
    },
    "ts-node": {
        "require": ["tsconfig-paths/register"]
    }
}